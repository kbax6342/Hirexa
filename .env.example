# Database
# Use .env.local for development values and keep production values in your host environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Profile/private field encryption
PROFILE_ENCRYPTION_KEY="replace-with-a-long-random-secret"
ENCRYPTION_KEY=""

# App-layer encryption for selected high-sensitivity fields
# Provide exactly 32 bytes as raw text, base64/base64url, or 64-char hex.
# Also used to encrypt TOTP 2FA secrets when 2FA is enabled.
APP_ENCRYPTION_KEY=""

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="same-as-auth-secret"
NEXTAUTH_URL="https://your-domain.example"
AUTH_URL="https://your-domain.example"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
APP_URL="https://your-domain.example"

# Optional if deployment uses Neon Auth-managed cookies / auth services
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# LinkedIn local callback URL: http://localhost:3000/api/auth/callback/linkedin
# Production callback URL: https://hirexa-ai.com/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email / SendGrid / Loops
SENDGRID_API_KEY=""
LOOPS_API_KEY=""
LOOPS_TRANSACTIONAL_API_KEY=""
EMAIL_FROM_ADDRESS="support@hirexa-ai.com"
EMAIL_FROM_NAME="Hirexa AI"
EMAIL_SENDING_DOMAIN="hirexa-ai.com"
EMAIL_FROM="Hirexa AI <support@hirexa-ai.com>"
SENDGRID_FROM="Hirexa AI <support@hirexa-ai.com>"
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME=""
SENDGRID_REPLY_TO=""
EMAIL_SECURITY_FROM_ADDRESS="noreply@hirexa-ai.com"
EMAIL_SECURITY_FROM_NAME="Hirexa AI"
EMAIL_SECURITY_REPLY_TO="support@hirexa-ai.com"
EMAIL_REPLY_TO="support@hirexa-ai.com"
EMAIL_SUPPORT="support@hirexa-ai.com"
WELCOME_EMAIL_CATEGORY="transactional"
CRON_SECRET="replace-with-a-long-random-secret"

# Billing / Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_TRIAL_PRICE_ID="price_trial_replace_me"
STRIPE_FULL_PRICE_ID="price_full_replace_me"
STRIPE_ANNUAL_PRICE_ID="price_annual_replace_me"
STRIPE_PRICE_JOB_HUNTER_PACK="price_pack_replace_me"
STRIPE_HIREPILOT_MONTHLY_PRICE_ID="price_hirepilot_monthly_replace_me"
STRIPE_HIREPILOT_CREDIT_PRICE_ID="price_hirepilot_credit_replace_me"
STRIPE_V1_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# AI / job-search providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
SERPAPI_API_KEY=""
JOB_SEARCH_PROVIDER_ORDER="serpapi_google,duckduckgo_html"
USAJOBS_KEY=""
USAJOBS_EMAIL=""
GREENHOUSE_BOARD_TOKENS=""
LEVER_COMPANY_SLUGS=""
LEVER_COMPANIES=""
ASHBY_COMPANIES=""
WORKABLE_COMPANIES=""
GOOGLE_MAPS_API_KEY=""
WORKDAY_BOARDS_JSON="[]"
WORKDAY_LOCALE="en-US"

# Anti-bot / client integrations
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_DROPBOX_APP_KEY=""
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=""
NEXT_PUBLIC_AUTOFILL_EXTENSION_URL=""

# Automation / remote browser
PLAYWRIGHT_ENABLED="false"
PLAYWRIGHT_HEADLESS="true"
# Optional: enable playwright-extra + puppeteer-extra-plugin-stealth runtime for auto-apply.
APPLY_STEALTH_ENABLED="false"
# Optional: enable read-only browser runtime diagnostics logging for auto-apply.
AUTO_APPLY_BROWSER_DIAGNOSTICS="false"
REMOTE_BROWSER_PROVIDER="scrapfly"
# Set REMOTE_BROWSER_PROVIDER="scrapfly" to use Scrapfly Cloud Browser for remote Chromium/CDP sessions.
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
# Scrapfly Cloud Browser
SCRAPFLY_API_KEY=""
# Optional Scrapfly defaults
SCRAPFLY_PROXY_POOL="datacenter"
SCRAPFLY_PROXY_COUNTRY="US"
SCRAPFLY_COUNTRY="us"
SCRAPFLY_OS="linux"
SCRAPFLY_AUTO_CLOSE="true"
SCRAPFLY_SESSION_TTL_SECONDS="900"
SCRAPFLY_TIMEOUT_SECONDS="900"
SCRAPFLY_SESSION_TTL_MS="900000"
# Optional: allow /api/dev/scrapfly-capability-check in production-like environments.
ENABLE_SCRAPFLY_DEV_CHECK="false"
AUTOMATION_WORKER_URL="http://127.0.0.1:4010"
AUTOMATION_SERVICE_TOKEN=""

# Optional debug flag
OUTREACH_DEBUG="0"

# Optional server-side OpenTelemetry / Google Cloud Trace
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hirexa-ai-local
OTEL_LOG_LEVEL=info
OTEL_EXPORTER=console
OTEL_METRICS_ENABLED=false
OTEL_AUTO_INSTRUMENTATIONS_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
