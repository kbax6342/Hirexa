generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id   String  @id @default(cuid())
  name String?

  // ✅ Guests can exist without email until final signup
  email    String? @unique
  password String?

  isGuest Boolean @default(true)

  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile UserProfile?
}

model UserProfile {
  id String @id @default(cuid())

  // ✅ guest flow
  guestId String? @unique

  // ✅ user flow
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // profile fields (keep what you need)
  skills             String[]  @default([])
  email              String?
  registrationStatus String?   @default("pending_verification")
  welcomeEmailSentAt DateTime?
  keyQuestions       Json?

  workplaceLocations Json?
  includeRemote      Boolean @default(true)

  newsletterOptIn  Boolean @default(false)
  newsletterSource String?

  trialSubscriber   Boolean @default(false)
  monthlySubscriber Boolean @default(false)
  yearlySubscriber  Boolean @default(false)

  trialPlanStatus       String?
  monthlyPlanStatus     String?
  yearlyPlanStatus      String?
  lastPaymentReceivedAt DateTime?
  subscriptionCheckedAt DateTime?
  subscriptionPurchasedAt DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionEmail     String?

  emailVerifiedAt DateTime?
  unsubscribedAt  DateTime?

  resumeSkills String[] @default([])

  minCompensation  Int?
  compensationType String?

  firstName            String?
  lastName             String?
  phone                String?
  profileImage         Bytes?
  profileImageMimeType String?
  profileImageFilename String?
  dob                  DateTime?
  address              String?
  city                 String?
  postalCode           String?
  state                String?

  linkedinUrl String?

  authorizedUS String?
  sponsorship  String?
  felony       String?
  startDate    String?
  screening    String?
  relocate     String?
  gender       String?
  pronouns     String?
  ethnicity    String?
  disability   String?
  veteran      String?

  // ✅ Resume is connected through profileId
  resume            Resume?
  jobInterests      JobInterest[]
  benefitSelections BenefitSelection[]
  resumeFiles       ResumeFile[]
  jobApplications   JobApplication[]
  stripePayments    StripePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model StripePayment {
  id String @id @default(cuid())

  userProfileId String?
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)

  stripeEventId       String @unique
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripeCheckoutSessionId String?
  stripeInvoiceId     String?
  stripePaymentIntentId String?

  planType  String?
  status    String?
  amount    Int?
  currency  String?
  paidAt    DateTime?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userProfileId])
  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
}

enum ApplicationStatus {
  IN_PREPARATION
  READY_TO_SEND
  IN_PROGRESS
  SENT
}

model JobApplication {
  id String @id @default(cuid())

  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  jobTitle String
  company  String
  location String?
  jobUrl   String?
  sourceJobId String?
  status   ApplicationStatus @default(IN_PREPARATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userProfileId])
  @@index([userProfileId, status])
  @@unique([userProfileId, sourceJobId])
}

model BenefitSelection {
  id String @id @default(cuid())

  userProfileId String?
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  guestId      String?
  selectedPlan String
  benefits     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userProfileId])
  @@index([guestId])
}

model JobInterest {
  id            String @id @default(cuid())
  userProfileId String
  uuid          String
  title         String

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, uuid])
  @@index([userProfileId])
}

//
// ✅ Resume table matches your Neon table:
// - userProfileId NOT NULL
// - UNIQUE(userProfileId) => 1 resume per profile
//
model Resume {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfileId String      @unique
  profile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  experiences       Experience[]
  resumeExperiences ResumeExperience[]

  @@index([userProfileId])
}

model ResumeExperience {
  resumeId    String   @id
  experiences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Experience {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  order     Int
  title     String
  company   String
  location  String?
  dateRange String?

  bullets Bullet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@index([resumeId, order])
}

model Bullet {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  order Int
  text  String

  @@index([experienceId])
  @@index([experienceId, order])
}

model EmailOtp {
  id          String    @id @default(cuid())
  email       String    @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  resendAfter DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ResumeFile {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fileName  String
  mimeType  String
  sizeBytes Int
  blob      Bytes

  createdAt DateTime @default(now())

  @@index([profileId])
}

model EmailVerificationCode {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
