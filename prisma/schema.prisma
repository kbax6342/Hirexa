generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResumeSubmissionStatus {
  UPLOADED
  PARSED
  EVALUATED
  NEEDS_REVIEW
  FAILED
}

enum ResumeFitRecommendation {
  STRONG_REVIEW
  REVIEW
  POSSIBLE_FIT
  WEAK_FIT
  INSUFFICIENT_INFO
}

model User {
  id                              String                     @id @default(cuid())
  name                            String?
  email                           String?                    @unique
  password                        String?
  twoFactorEnabled                Boolean                    @default(false)
  twoFactorSecretEncrypted        String?
  twoFactorPendingSecretEncrypted String?
  twoFactorConfirmedAt            DateTime?
  twoFactorDisabledAt             DateTime?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  isGuest                         Boolean                    @default(true)
  emailVerifiedAt                 DateTime?
  userProfile                     UserProfile?
  billings                        UserBilling[]
  savedJobs                       SavedJob[]
  hirePilotCreditGrants           HirePilotCreditGrant[]
  hirePilotCreditUsages           HirePilotCreditUsage[]
  passwordResetTokens             PasswordResetToken[]
  twoFactorBackupCodes            TwoFactorBackupCode[]
  recruiterAgency                 RecruiterAgency?           @relation("RecruiterAgencyOwner")
  recruiterProfile                RecruiterProfile?
  resumeEvaluationAuditLogs       ResumeEvaluationAuditLog[]
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LinkedInAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  provider          String    @default("linkedin_sim")
  connectedAt       DateTime  @default(now())
  importedName      String?
  importedHeadline  String?
  importedLocation  String?
  importedSkills    String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  accessToken       String?
  email             String?
  providerAccountId String?   @unique
  refreshToken      String?
  tokenExpiresAt    DateTime?
  tokenScope        String?
}

model OutreachCampaign {
  id              String              @id @default(cuid())
  userId          String              @unique
  targetCompanies String[]            @default([])
  targetRoles     String[]            @default([])
  targetTitles    String[]            @default([])
  location        String?
  dailyLimit      Int                 @default(10)
  autoFollowUp    Boolean             @default(true)
  followUpDays    Int                 @default(5)
  tone            String              @default("professional")
  shortBio        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  jobTargets      OutreachJobTarget[]
  templates       OutreachTemplate[]
  leads           RecruiterLead[]
}

model OutreachTemplate {
  id         String           @id @default(cuid())
  campaignId String
  name       String
  body       String
  isDefault  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model RecruiterLead {
  id                  String             @id @default(cuid())
  campaignId          String
  outreachJobTargetId String?
  name                String
  company             String
  title               String
  linkedinUrl         String
  connectionLevel     String             @default("2nd")
  status              String             @default("READY")
  lastMessagedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  confidence          Int                @default(60)
  contactEmail        String?
  leadType            String             @default("recruiter_search")
  messages            OutreachMessage[]
  campaign            OutreachCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outreachJobTarget   OutreachJobTarget? @relation(fields: [outreachJobTargetId], references: [id])

  @@unique([campaignId, linkedinUrl])
  @@index([campaignId])
}

model OutreachMessage {
  id         String        @id @default(cuid())
  leadId     String
  templateId String?
  body       String
  status     String        @default("DRAFT")
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lead       RecruiterLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model OutreachJobTarget {
  id           String           @id @default(cuid())
  campaignId   String
  userId       String
  jobId        String
  company      String
  title        String
  location     String?
  source       String?
  status       String           @default("ACTIVE")
  leadsFound   Int              @default(0)
  messagesSent Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaign     OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads        RecruiterLead[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([campaignId])
}

model UserProfile {
  id                      String                @id @default(cuid())
  userId                  String?               @unique
  firstName               String?
  lastName                String?
  phone                   String?
  authorizedUS            String?
  sponsorship             String?
  felony                  String?
  startDate               String?
  screening               String?
  relocate                String?
  gender                  String?
  pronouns                String?
  ethnicity               String?
  disability              String?
  veteran                 String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  guestId                 String?               @unique
  compensationType        String?
  minCompensation         Int?
  resumeSkills            String[]              @default([])
  skills                  String[]              @default([])
  email                   String?
  welcomeEmailSentAt      DateTime?
  includeRemote           Boolean               @default(true)
  workplaceLocations      Json?
  newsletterOptIn         Boolean               @default(false)
  newsletterSource        String?
  emailVerifiedAt         DateTime?
  unsubscribedAt          DateTime?
  registrationStatus      String?               @default("pending_verification")
  address                 String?
  addressEncrypted        String?
  city                    String?
  cityEncrypted           String?
  citySearch              String?
  dob                     DateTime?
  dobEncrypted            String?
  linkedinUrl             String?
  postalCode              String?
  postalCodeEncrypted     String?
  postalCodeSearch        String?
  state                   String?
  stateEncrypted          String?
  stateSearch             String?
  keyQuestions            Json?
  profileImage            Bytes?
  profileImageMimeType    String?
  profileImageFilename    String?
  trialSubscriber         Boolean               @default(false)
  monthlySubscriber       Boolean               @default(false)
  yearlySubscriber        Boolean               @default(false)
  trialPlanStatus         String?
  monthlyPlanStatus       String?
  yearlyPlanStatus        String?
  lastPaymentReceivedAt   DateTime?
  subscriptionCheckedAt   DateTime?
  subscriptionPurchasedAt DateTime?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  subscriptionEmail       String?
  countryCode             String?
  country                 String?
  portfolioUrl            String?
  professionalLinks       Json?
  questionsCompleted      Boolean               @default(false)
  benefitSelections       BenefitSelection[]
  applySiteStrategies     ApplySiteStrategy[]
  jobApplications         JobApplication[]
  jobInterests            JobInterest[]
  resume                  Resume?
  resumeFiles             ResumeFile[]
  stripePayments          StripePayment[]
  emailLifecycleEvents    EmailLifecycleEvent[]
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([citySearch])
  @@index([stateSearch])
  @@index([postalCodeSearch])
}

model ApplySiteStrategy {
  id String @id @default(cuid())

  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  strategyKey        String
  hostname           String
  sourceHost         String?
  destinationHost    String?
  strategyType       String   @default("generic_navigation")
  pageType           String   @default("unknown")
  finalUrl           String?
  lastAction         String?
  stopReason         String?
  supportedReasons   String[] @default([])
  instructions       String?
  selectors          String?
  stepsJson          Json?
  rawStepsJson       Json?
  sanitizedStepsJson Json?
  jobTitle           String?
  company            String?
  location           String?
  derivedInstruction String?
  automationPrompt   String?
  trainingSource     String?
  lastTrainedUrl     String?

  status              String    @default("draft")
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  successfulReplays   Int       @default(0)
  failedReplays       Int       @default(0)
  lastReplaySucceeded Boolean?
  lastFailureReason   String?
  replayStatus        String?
  lastReplayResult    Json?
  failingStepId       String?
  lastReplayedAt      DateTime?
  lastReplayAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProfileId, strategyKey])
  @@index([userProfileId])
  @@index([hostname])
  @@index([sourceHost])
  @@index([destinationHost])
  @@index([userProfileId, sourceHost, pageType, strategyType])
  @@index([userProfileId, status])
}

model OnboardingDraft {
  id         String    @id @default(cuid())
  draftToken String    @unique
  guestId    String?
  status     String    @default("active")
  lastStep   String?
  payload    Json?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([guestId])
  @@index([status, expiresAt])
}

model EmailLifecycleEvent {
  id            String       @id @default(cuid())
  userProfileId String?
  email         String
  eventKey      String
  eventGroup    String
  dedupeKey     String       @unique
  sentAt        DateTime     @default(now())
  createdAt     DateTime     @default(now())
  meta          Json?
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)

  @@index([userProfileId, eventGroup])
  @@index([email, eventGroup])
  @@index([sentAt])
}

model StripePayment {
  id                      String       @id @default(cuid())
  userProfileId           String?
  stripeEventId           String       @unique
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripeCheckoutSessionId String?
  stripeInvoiceId         String?
  stripePaymentIntentId   String?
  planType                String?
  status                  String?
  amount                  Int?
  currency                String?
  paidAt                  DateTime?
  metadata                Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  userProfile             UserProfile? @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
}

model JobApplication {
  id                   String      @id @default(cuid())
  userProfileId        String
  jobTitle             String
  company              String
  status               String      @default("READY_TO_APPLY")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  location             String?
  jobUrl               String?
  sourceJobId          String?
  answersJson          Json?
  auditJson            Json?
  submittedAt          DateTime?
  title                String?
  source               String?
  missingFields        String[]    @default([])
  submissionProof      Json?
  failureReason        String?
  verificationRequired Boolean     @default(false)
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, sourceJobId])
  @@index([userProfileId])
  @@index([userProfileId, status])
}

model BenefitSelection {
  id            String       @id @default(cuid())
  userProfileId String?
  guestId       String?
  selectedPlan  String
  benefits      String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@index([guestId])
}

model JobInterest {
  id            String      @id @default(cuid())
  userProfileId String
  uuid          String
  title         String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, uuid])
  @@index([userProfileId])
}

model Resume {
  id                String            @id @default(cuid())
  filename          String
  mimeType          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userProfileId     String            @unique
  experiences       Experience[]
  profile           UserProfile       @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  resumeExperiences ResumeExperience?

  @@index([userProfileId])
}

model ResumeExperience {
  resumeId    String   @id
  experiences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Experience {
  id        String   @id @default(cuid())
  resumeId  String
  order     Int
  title     String
  company   String
  location  String?
  dateRange String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bullets   Bullet[]
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([resumeId, order])
}

model Bullet {
  id           String     @id @default(cuid())
  experienceId String
  order        Int
  text         String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([experienceId, order])
}

model EmailOtp {
  id          String    @id @default(cuid())
  email       String    @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  resendAfter DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ResumeFile {
  id        String      @id @default(cuid())
  profileId String
  fileName  String
  mimeType  String
  sizeBytes Int
  blob      Bytes
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  title     String
  company   String
  location  String?
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([createdAt])
}

model EmailVerificationCode {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model JobHunterPack {
  id              String    @id @default(cuid())
  guestId         String
  userId          String?
  jobId           String?
  jobTitle        String?
  company         String?
  jobUrl          String?
  jobDescription  String?
  resumeText      String?
  notes           String?
  optimizedResume String?
  coverLetter     String?
  interviewPrep   String?
  status          String    @default("draft")
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  purchase        Purchase?

  @@index([guestId])
  @@index([userId])
  @@index([status])
}

model Purchase {
  id              String        @id @default(cuid())
  productKey      String
  status          String        @default("pending")
  guestId         String
  userId          String?
  amount          Int?
  currency        String?
  stripeSessionId String?       @unique
  stripePaymentId String?
  packId          String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pack            JobHunterPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([userId])
  @@index([status])
}

model StripeCustomer {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id
  userId    String
  status    String
  priceId   String
  createdAt DateTime @default(now())
}

model HirePilotUsage {
  id                String    @id @default(cuid())
  userId            String
  jobTitle          String?
  company           String?
  status            String    @default("listening")
  inputSource       String?
  reportEligible    Boolean   @default(false)
  endedAt           DateTime?
  transcript        Json?
  detectedQuestions Json?
  suggestedAnswers  Json?
  report            Json?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
}

model HirePilotCreditGrant {
  id                      String                 @id @default(cuid())
  userId                  String
  sourceType              String
  totalCredits            Int
  remainingCredits        Int
  grantKey                String?                @unique
  grantedAt               DateTime               @default(now())
  cycleStart              DateTime?
  cycleEnd                DateTime?
  expiresAt               DateTime?
  stripeCheckoutSessionId String?
  stripeInvoiceId         String?
  stripeSubscriptionId    String?
  metadata                Json?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages                  HirePilotCreditUsage[]

  @@index([userId, sourceType])
  @@index([userId, expiresAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripeInvoiceId])
  @@index([stripeSubscriptionId])
}

model HirePilotCreditUsage {
  id               String                @id @default(cuid())
  userId           String
  grantId          String?
  usageKey         String?               @unique
  amount           Int                   @default(1)
  sourceType       String?
  hirePilotUsageId String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant            HirePilotCreditGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([grantId])
  @@index([hirePilotUsageId])
}

model UserBilling {
  id     String @id @default(cuid())
  userId String

  productKey String
  planType   String?
  status     String?

  hirePilotCredits   Int     @default(0)
  hirePilotUnlimited Boolean @default(false)

  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeProductId         String?
  stripeCheckoutSessionId String?

  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  canceledAt              DateTime?
  trialStart              DateTime?
  trialEnd                DateTime?
  lastPaymentReceivedAt   DateTime?
  subscriptionPurchasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productKey])
  @@index([userId])
  @@index([productKey])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model CompanyChatbot {
  id                        String                     @id @default(cuid())
  companyName               String
  companySlug               String                     @unique
  websiteUrl                String?
  industry                  String?
  companyDescription        String?                    @db.Text
  mainContactEmail          String?
  recruiterEmail            String?
  companyPhone              String?
  locationsServed           String[]                   @default([])
  logoUrl                   String?
  brandColor                String?
  chatTitle                 String?
  chatSubtitle              String?
  welcomeMessage            String?                    @db.Text
  fallbackMessage           String?                    @db.Text
  tone                      String                     @default("professional")
  greetingStyle             String?
  showAiDisclosure          Boolean                    @default(true)
  useEmojis                 Boolean                    @default(false)
  answerLength              String                     @default("concise")
  fallbackBehavior          String?
  requiredCandidateFields   String[]                   @default([])
  optionalCandidateFields   String[]                   @default([])
  requiredTransportation    String?
  requiredWorkAuthorization String?
  requiredShiftAvailability String[]                   @default([])
  minimumYearsExperience    Int?
  requiredCertifications    String[]                   @default([])
  disqualifyingAnswers      Json?
  candidateScoreThreshold   Int?
  saveLeadToDashboard       Boolean                    @default(true)
  sendEmailNotification     Boolean                    @default(false)
  webhookUrl                String?
  redirectUrl               String?
  completionMessage         String?                    @db.Text
  isActive                  Boolean                    @default(true)
  isDemoMode                Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  leads                     ChatbotCandidateLead[]
  messages                  ChatbotMessage[]
  jobs                      ChatbotJobOpening[]
  questions                 ChatbotScreeningQuestion[]

  @@index([isActive])
  @@index([isDemoMode])
  @@index([createdAt])
}

model ChatbotJobOpening {
  id               String         @id @default(cuid())
  companyChatbotId String
  title            String
  location         String?
  payRange         String?
  shift            String?
  employmentType   String?
  requirements     String?        @db.Text
  applicationUrl   String?
  description      String?        @db.Text
  status           String         @default("OPEN")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyChatbot   CompanyChatbot @relation(fields: [companyChatbotId], references: [id], onDelete: Cascade)

  @@index([companyChatbotId])
  @@index([companyChatbotId, status])
  @@index([createdAt])
}

model ChatbotCandidateLead {
  id                    String                   @id @default(cuid())
  companyChatbotId      String
  firstName             String?
  lastName              String?
  email                 String?
  phone                 String?
  city                  String?
  state                 String?
  zipCode               String?
  desiredJobType        String?
  employmentType        String?
  preferredShift        String?
  availability          Json?
  workExperienceSummary String?                  @db.Text
  yearsExperience       Int?
  transportationStatus  String?
  workAuthorization     String?
  sponsorshipRequired   Boolean?
  resumeUrl             String?
  linkedinUrl           String?
  certifications        String[]                 @default([])
  desiredPay            String?
  startDate             String?
  previousEmployer      String?
  educationLevel        String?
  languagesSpoken       String[]                 @default([])
  veteranStatus         String?
  referralSource        String?
  qualificationStatus   String?
  candidateScore        Int?
  aiSummary             String?                  @db.Text
  missingFields         String[]                 @default([])
  structuredAnswersJson Json?
  sourcePageUrl         String?
  utmSource             String?
  utmCampaign           String?
  consentAcceptedAt     DateTime?
  aiDisclosureShownAt   DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  companyChatbot        CompanyChatbot           @relation(fields: [companyChatbotId], references: [id], onDelete: Cascade)
  messages              ChatbotMessage[]
  answers               ChatbotCandidateAnswer[]

  @@index([companyChatbotId])
  @@index([companyChatbotId, createdAt])
  @@index([email])
  @@index([phone])
  @@index([qualificationStatus])
  @@index([createdAt])
}

model ChatbotMessage {
  id               String                @id @default(cuid())
  companyChatbotId String
  leadId           String?
  role             String
  content          String                @db.Text
  metadata         Json?
  createdAt        DateTime              @default(now())
  companyChatbot   CompanyChatbot        @relation(fields: [companyChatbotId], references: [id], onDelete: Cascade)
  lead             ChatbotCandidateLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyChatbotId])
  @@index([leadId])
  @@index([createdAt])
}

model ChatbotScreeningQuestion {
  id               String                   @id @default(cuid())
  companyChatbotId String
  questionText     String                   @db.Text
  questionType     String                   @default("text")
  isRequired       Boolean                  @default(false)
  isOptional       Boolean                  @default(false)
  isKnockout       Boolean                  @default(false)
  options          Json?
  order            Int                      @default(0)
  expectedAnswer   String?                  @db.Text
  conditionalLogic Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  companyChatbot   CompanyChatbot           @relation(fields: [companyChatbotId], references: [id], onDelete: Cascade)
  answers          ChatbotCandidateAnswer[]

  @@index([companyChatbotId])
  @@index([companyChatbotId, order])
  @@index([questionType])
}

model ChatbotCandidateAnswer {
  id         String                   @id @default(cuid())
  leadId     String
  questionId String
  answerText String?                  @db.Text
  answerJson Json?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  lead       ChatbotCandidateLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  question   ChatbotScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([leadId, questionId])
  @@index([leadId])
  @@index([questionId])
}

model RecruiterAgency {
  id                String               @id @default(cuid())
  ownerUserId       String               @unique
  name              String
  slug              String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  ownerUser         User                 @relation("RecruiterAgencyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  jobOrders         RecruiterJobOrder[]
  candidates        RecruiterCandidate[]
  jobRequisitions   JobRequisition[]
  candidateProfiles CandidateProfile[]

  @@index([slug])
}

model RecruiterProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  firstName             String?
  lastName              String?
  jobTitle              String?
  workEmail             String?
  phone                 String?
  linkedinUrl           String?
  agencyName            String?
  agencyWebsite         String?
  city                  String?
  state                 String?
  companyDescription    String?  @db.Text
  hiringIndustries      String[] @default([])
  recruitingSpecialties String[] @default([])
  hiringRoles           String[] @default([])
  seniorityLevels       String[] @default([])
  employmentTypes       String[] @default([])
  workModes             String[] @default([])
  hiringLocations       String[] @default([])
  calendarUrl           String?
  intakeEmail           String?
  resumeSubmissionEmail String?
  outreachTone          String?  @default("professional")
  autoFollowUp          Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agencyName])
  @@index([workEmail])
}

model RecruiterJobOrder {
  id                      String                @id @default(cuid())
  agencyId                String
  title                   String
  companyName             String
  location                String?
  employmentType          String?
  salaryMin               Int?
  salaryMax               Int?
  description             String                @db.Text
  requiredSkills          String[]              @default([])
  preferredSkills         String[]              @default([])
  requiredYearsExperience Int?
  status                  String                @default("OPEN")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  agency                  RecruiterAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  matches                 RecruiterMatch[]
  submissions             RecruiterSubmission[]
  jobRequisition          JobRequisition?

  @@index([agencyId])
  @@index([agencyId, status])
  @@index([updatedAt])
}

model RecruiterCandidate {
  id              String                   @id @default(cuid())
  agencyId        String
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  location        String?
  headline        String?
  resumeText      String?                  @db.Text
  skills          String[]                 @default([])
  yearsExperience Int?
  source          String                   @default("UPLOAD")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  agency          RecruiterAgency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  files           RecruiterCandidateFile[]
  matches         RecruiterMatch[]
  submissions     RecruiterSubmission[]

  @@index([agencyId])
  @@index([agencyId, email])
  @@index([updatedAt])
}

model RecruiterCandidateFile {
  id          String             @id @default(cuid())
  candidateId String
  filename    String
  mimeType    String
  fileUrl     String?
  rawText     String?            @db.Text
  createdAt   DateTime           @default(now())
  candidate   RecruiterCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model RecruiterMatch {
  id                    String             @id @default(cuid())
  jobOrderId            String
  candidateId           String
  score                 Int
  bestFitReasons        Json
  redFlags              Json
  missingQualifications Json
  summary               String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  jobOrder              RecruiterJobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  candidate             RecruiterCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobOrderId, candidateId])
  @@index([jobOrderId, score])
  @@index([candidateId])
}

model RecruiterSubmission {
  id                  String                @id @default(cuid())
  jobOrderId          String
  candidateId         String
  stage               String                @default("SCREENED")
  notes               String?               @db.Text
  lastOutreachMessage String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  jobOrder            RecruiterJobOrder     @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  candidate           RecruiterCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stageEvents         RecruiterStageEvent[]

  @@unique([jobOrderId, candidateId])
  @@index([jobOrderId])
  @@index([candidateId])
  @@index([jobOrderId, stage])
}

model RecruiterStageEvent {
  id           String              @id @default(cuid())
  submissionId String
  fromStage    String?
  toStage      String
  note         String?             @db.Text
  createdAt    DateTime            @default(now())
  submission   RecruiterSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([createdAt])
}

model JobRequisition {
  id                  String                     @id @default(cuid())
  agencyId            String
  recruiterJobOrderId String?                    @unique
  title               String
  companyName         String
  jobDescription      String                     @db.Text
  requiredSkills      String[]                   @default([])
  preferredSkills     String[]                   @default([])
  experienceLevel     String?
  location            String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  agency              RecruiterAgency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  recruiterJobOrder   RecruiterJobOrder?         @relation(fields: [recruiterJobOrderId], references: [id], onDelete: SetNull)
  resumeSubmissions   ResumeSubmission[]
  evaluations         ResumeEvaluation[]
  auditLogs           ResumeEvaluationAuditLog[]

  @@index([agencyId])
  @@index([agencyId, updatedAt])
}

model CandidateProfile {
  id                String             @id @default(cuid())
  agencyId          String
  name              String?
  email             String?
  phone             String?
  currentTitle      String?
  location          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  agency            RecruiterAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  resumeSubmissions ResumeSubmission[]

  @@unique([agencyId, email])
  @@index([agencyId])
  @@index([agencyId, createdAt])
}

model ResumeSubmission {
  id               String                     @id @default(cuid())
  candidateId      String
  jobRequisitionId String
  originalFileName String
  fileUrl          String?
  storageKey       String?
  mimeType         String
  parsedText       String?                    @db.Text
  parsedJson       Json?
  status           ResumeSubmissionStatus     @default(UPLOADED)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  candidate        CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRequisition   JobRequisition             @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  evaluations      ResumeEvaluation[]
  auditLogs        ResumeEvaluationAuditLog[]

  @@index([candidateId])
  @@index([jobRequisitionId])
  @@index([jobRequisitionId, status])
  @@index([createdAt])
}

model ResumeEvaluation {
  id                  String                      @id @default(cuid())
  resumeSubmissionId  String
  jobRequisitionId    String
  overallScore        Int
  confidence          String
  recommendation      ResumeFitRecommendation
  summary             String                      @db.Text
  strengths           Json
  gaps                Json
  evidence            Json
  interviewQuestions  Json
  missingInformation  Json
  humanReviewNote     String?                     @db.Text
  humanReviewRequired Boolean                     @default(true)
  modelName           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  resumeSubmission    ResumeSubmission            @relation(fields: [resumeSubmissionId], references: [id], onDelete: Cascade)
  jobRequisition      JobRequisition              @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  criteria            ResumeEvaluationCriterion[]

  @@index([resumeSubmissionId])
  @@index([resumeSubmissionId, createdAt])
  @@index([jobRequisitionId, overallScore])
}

model ResumeEvaluationCriterion {
  id           String           @id @default(cuid())
  evaluationId String
  label        String
  weight       Int
  score        Int
  rationale    String           @db.Text
  evidence     Json
  evaluation   ResumeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model ResumeEvaluationAuditLog {
  id                 String           @id @default(cuid())
  resumeSubmissionId String
  jobRequisitionId   String
  action             String
  actorId            String?
  metadata           Json
  createdAt          DateTime         @default(now())
  resumeSubmission   ResumeSubmission @relation(fields: [resumeSubmissionId], references: [id], onDelete: Cascade)
  jobRequisition     JobRequisition   @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  actor              User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resumeSubmissionId])
  @@index([resumeSubmissionId, createdAt])
  @@index([jobRequisitionId])
}
