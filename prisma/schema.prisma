generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String?       @unique
  password        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isGuest         Boolean       @default(true)
  emailVerifiedAt DateTime?
  userProfile     UserProfile?
  billings        UserBilling[]
}

model LinkedInAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  provider          String    @default("linkedin_sim")
  connectedAt       DateTime  @default(now())
  importedName      String?
  importedHeadline  String?
  importedLocation  String?
  importedSkills    String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  accessToken       String?
  email             String?
  providerAccountId String?   @unique
  refreshToken      String?
  tokenExpiresAt    DateTime?
  tokenScope        String?
}

model OutreachCampaign {
  id              String              @id @default(cuid())
  userId          String              @unique
  targetCompanies String[]            @default([])
  targetRoles     String[]            @default([])
  targetTitles    String[]            @default([])
  location        String?
  dailyLimit      Int                 @default(10)
  autoFollowUp    Boolean             @default(true)
  followUpDays    Int                 @default(5)
  tone            String              @default("professional")
  shortBio        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  jobTargets      OutreachJobTarget[]
  templates       OutreachTemplate[]
  leads           RecruiterLead[]
}

model OutreachTemplate {
  id         String           @id @default(cuid())
  campaignId String
  name       String
  body       String
  isDefault  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model RecruiterLead {
  id                  String             @id @default(cuid())
  campaignId          String
  outreachJobTargetId String?
  name                String
  company             String
  title               String
  linkedinUrl         String
  connectionLevel     String             @default("2nd")
  status              String             @default("READY")
  lastMessagedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  confidence          Int                @default(60)
  contactEmail        String?
  leadType            String             @default("recruiter_search")
  messages            OutreachMessage[]
  campaign            OutreachCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outreachJobTarget   OutreachJobTarget? @relation(fields: [outreachJobTargetId], references: [id])

  @@unique([campaignId, linkedinUrl])
  @@index([campaignId])
}

model OutreachMessage {
  id         String        @id @default(cuid())
  leadId     String
  templateId String?
  body       String
  status     String        @default("DRAFT")
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lead       RecruiterLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model OutreachJobTarget {
  id           String           @id @default(cuid())
  campaignId   String
  userId       String
  jobId        String
  company      String
  title        String
  location     String?
  source       String?
  status       String           @default("ACTIVE")
  leadsFound   Int              @default(0)
  messagesSent Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaign     OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads        RecruiterLead[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([campaignId])
}

model UserProfile {
  id                      String             @id @default(cuid())
  userId                  String?            @unique
  firstName               String?
  lastName                String?
  phone                   String?
  authorizedUS            String?
  sponsorship             String?
  felony                  String?
  startDate               String?
  screening               String?
  relocate                String?
  gender                  String?
  pronouns                String?
  ethnicity               String?
  disability              String?
  veteran                 String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  guestId                 String?            @unique
  compensationType        String?
  minCompensation         Int?
  resumeSkills            String[]           @default([])
  skills                  String[]           @default([])
  email                   String?
  welcomeEmailSentAt      DateTime?
  includeRemote           Boolean            @default(true)
  workplaceLocations      Json?
  newsletterOptIn         Boolean            @default(false)
  newsletterSource        String?
  emailVerifiedAt         DateTime?
  unsubscribedAt          DateTime?
  registrationStatus      String?            @default("pending_verification")
  address                 String?
  addressEncrypted        String?
  city                    String?
  cityEncrypted           String?
  citySearch              String?
  dob                     DateTime?
  dobEncrypted            String?
  linkedinUrl             String?
  postalCode              String?
  postalCodeEncrypted     String?
  postalCodeSearch        String?
  state                   String?
  stateEncrypted          String?
  stateSearch             String?
  keyQuestions            Json?
  profileImage            Bytes?
  profileImageMimeType    String?
  profileImageFilename    String?
  trialSubscriber         Boolean            @default(false)
  monthlySubscriber       Boolean            @default(false)
  yearlySubscriber        Boolean            @default(false)
  trialPlanStatus         String?
  monthlyPlanStatus       String?
  yearlyPlanStatus        String?
  lastPaymentReceivedAt   DateTime?
  subscriptionCheckedAt   DateTime?
  subscriptionPurchasedAt DateTime?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  subscriptionEmail       String?
  countryCode             String?
  country                 String?
  portfolioUrl            String?
  questionsCompleted      Boolean            @default(false)
  benefitSelections       BenefitSelection[]
  jobApplications         JobApplication[]
  jobInterests            JobInterest[]
  resume                  Resume?
  resumeFiles             ResumeFile[]
  stripePayments          StripePayment[]
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([citySearch])
  @@index([stateSearch])
  @@index([postalCodeSearch])
}

model StripePayment {
  id                      String       @id @default(cuid())
  userProfileId           String?
  stripeEventId           String       @unique
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripeCheckoutSessionId String?
  stripeInvoiceId         String?
  stripePaymentIntentId   String?
  planType                String?
  status                  String?
  amount                  Int?
  currency                String?
  paidAt                  DateTime?
  metadata                Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  userProfile             UserProfile? @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
}

model JobApplication {
  id                   String      @id @default(cuid())
  userProfileId        String
  jobTitle             String
  company              String
  status               String      @default("READY_TO_APPLY")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  location             String?
  jobUrl               String?
  sourceJobId          String?
  answersJson          Json?
  auditJson            Json?
  submittedAt          DateTime?
  title                String?
  source               String?
  missingFields        String[]    @default([])
  submissionProof      Json?
  failureReason        String?
  verificationRequired Boolean     @default(false)
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, sourceJobId])
  @@index([userProfileId])
  @@index([userProfileId, status])
}

model BenefitSelection {
  id            String       @id @default(cuid())
  userProfileId String?
  guestId       String?
  selectedPlan  String
  benefits      String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@index([guestId])
}

model JobInterest {
  id            String      @id @default(cuid())
  userProfileId String
  uuid          String
  title         String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, uuid])
  @@index([userProfileId])
}

model Resume {
  id                String            @id @default(cuid())
  filename          String
  mimeType          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userProfileId     String            @unique
  experiences       Experience[]
  profile           UserProfile       @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  resumeExperiences ResumeExperience?

  @@index([userProfileId])
}

model ResumeExperience {
  resumeId    String   @id
  experiences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Experience {
  id        String   @id @default(cuid())
  resumeId  String
  order     Int
  title     String
  company   String
  location  String?
  dateRange String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bullets   Bullet[]
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([resumeId, order])
}

model Bullet {
  id           String     @id @default(cuid())
  experienceId String
  order        Int
  text         String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([experienceId, order])
}

model EmailOtp {
  id          String    @id @default(cuid())
  email       String    @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  resendAfter DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ResumeFile {
  id        String      @id @default(cuid())
  profileId String
  fileName  String
  mimeType  String
  sizeBytes Int
  blob      Bytes
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model EmailVerificationCode {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobHunterPack {
  id              String    @id @default(cuid())
  guestId         String
  userId          String?
  jobId           String?
  jobTitle        String?
  company         String?
  jobUrl          String?
  jobDescription  String?
  resumeText      String?
  notes           String?
  optimizedResume String?
  coverLetter     String?
  interviewPrep   String?
  status          String    @default("draft")
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  purchase        Purchase?

  @@index([guestId])
  @@index([userId])
  @@index([status])
}

model Purchase {
  id              String        @id @default(cuid())
  productKey      String
  status          String        @default("pending")
  guestId         String
  userId          String?
  amount          Int?
  currency        String?
  stripeSessionId String?       @unique
  stripePaymentId String?
  packId          String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pack            JobHunterPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([userId])
  @@index([status])
}

model StripeCustomer {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id
  userId    String
  status    String
  priceId   String
  createdAt DateTime @default(now())
}

model HirePilotUsage {
  id        String   @id @default(cuid())
  userId    String
  jobTitle  String?
  company   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserBilling {
  id     String @id @default(cuid())
  userId String

  productKey String
  planType   String?
  status     String?

  hirePilotCredits   Int     @default(0)
  hirePilotUnlimited Boolean @default(false)

  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeProductId         String?
  stripeCheckoutSessionId String?

  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  canceledAt              DateTime?
  trialStart              DateTime?
  trialEnd                DateTime?
  lastPaymentReceivedAt   DateTime?
  subscriptionPurchasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productKey])
  @@index([userId])
  @@index([productKey])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}
